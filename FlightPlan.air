% AirLang Flight Plan  
  Includes sample aircraft, flight, and route, data-ready for takeoff! %
^^ The only bug in FlightPlan is STALL

MAIN {
    BRIEFING {
        AIRCRAFT {
            AircraftID: C-GHPQ;
            Type: "B747";
            FuelCapacity: 26000;
            CruiseSpeed: 430;
            FuelPerNM: 35;
        }

        FLIGHT {
            FlightNumber: AL123;
            Date: '2025-05-15';
            Status: "on time";
            Weather: "clear";
            ETA: 1.5;
            EstimatedFuelRequired: 1575;
        }

        ROUTE {
            DepartureAirport: "YOW";
	    DepartureName: "Ottawa International Airport";
            DepartureCoordinates: 45.3225, -75.6692;
            ArrivalAirport: "YYZ";
            ArrivalName: "Toronto Pearson International Airport" ;
            ArrivalCoordinates: 43.6777, -79.6248;
        }
    } ENDBRIEFING;

    DISPATCH {
        IF Weather != "clear" THEN
            PRINT "NOTAM: Flight delayed due to weather";
        ELSE
            PRINT "NOTAM: Flight is on time";
        ENDIF;

        REPORT {
            calculateDistance();
            calculateETA();
            printFlightSummary();
        } ENDREPORT;
    } ENDDISPATCH;
} ENDMAIN;


FlightTip: "StallException- sky's not the limit , STALL is! Debug Altitude Now"